{
    "symbol-whitelist": [
        "null",
        "true",
        "false",
        "static",
        "self",
        "parent",
        "array",
        "string",
        "int",
        "float",
        "bool",
        "iterable",
        "callable",
        "void",
        "object",
        "random_bytes",
        "posix_kill",
        "posix_setsid",
        "pcntl_async_signals",
        "pcntl_signal",
        "pcntl_signal_get_handler",
        "SIGINT",
        "SIGTERM",
        "SIG_DFL",
        "sapi_windows_set_ctrl_handler"
