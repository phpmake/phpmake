{
    "name": "MyProject",
    "description": "Sample build file demonstrating PHPMake build tool capabilities.",
    "version": "2.1.0",
    "targets": {
        "clean": {
            "description": "Remove build artifacts.",
            "tasks": [
                {"type": "delete", "params": {"path": "build"}}
            ]
        },
        "build": {
            "description": "Build project files.",
            "depends": ["clean"],
            "tasks": [
                {"type": "create_directory", "params": {"name": "build"}},
                {"type": "copy", "params": {"source": "src/", "dest": "build/"}},
                {"type": "echo", "params": {"message": "Replace this step with your project compiler command."}},
                {"type": "echo", "params": {"message": "Build completed successfully."}}
            ]
        },
        "test": {
            "description": "Run unit tests",
            "depends": ["build"],
            "tasks": [
                {"type": "echo", "params": {"message": "Configure your project test runner here."}}
            ]
        },
        "package": {
            "description": "Create distributable package.",
            "depends": ["test"],
            "tasks": [
                {"type": "archive", "params": {"source": "build/", "output": "dist/myproject.zip"}}
            ]
        }
    },
    "default_target": "build"
}
